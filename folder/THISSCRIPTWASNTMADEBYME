Creator.createEntity = function(config)

    assert(typeof(config) == "table")
    assert(config.Model)

    for i, v in next, DefaultConfig do

        if config[i] == nil then
            config[i] = v
        end

    end

    config.Speed =
        StaticRushSpeed
        / 100
        * config.Speed

    --------------------------------------------------
    -- LOAD MODEL
    --------------------------------------------------

    local entityModel =
        LoadCustomInstance(
            config.Model
        )

    if typeof(entityModel) == "Instance"
        and entityModel:IsA("Model") then

        local pPart =
            entityModel.PrimaryPart
            or entityModel:FindFirstChildWhichIsA(
                "BasePart"
            )

        if pPart then

            entityModel.PrimaryPart =
                pPart

            pPart.Anchored = true

            entityModel:SetAttribute(
                "IsCustomEntity",
                true
            )

            if config.CustomName then

                entityModel.Name =
                    config.CustomName

            end

            for _, v in next,
                entityModel:GetDescendants() do

                if v:IsA("BasePart") then
                    v.CanCollide = false
                end

            end

            Connections[entityModel] = {}

            return {
                Model = entityModel,
                Config = config,

                Debug = {
                    OnEntitySpawned = function() end,
                    OnEntityDespawned = function() end,
                    OnEntityStartMoving = function() end,
                    OnEntityFinishedRebound = function() end,
                    OnEntityEnteredRoom = function() end,
                    OnLookAtEntity = function() end,
                    OnDeath = function() end,
                },
            }

        else

            warn(
                "Failure - Could not find model's PrimaryPart"
            )

        end

    else

        warn(
            "Failure - Could not obtain model"
        )

    end
end

--------------------------------------------------
-- RUN ENTITY
--------------------------------------------------

Creator.runEntity = function(entity)

    if not entity or not entity.Model then

        warn("Invalid entity")

        return
    end

    --------------------------------------------------
    -- GET LATEST ROOM
    --------------------------------------------------

    local latestRoom = 0

    pcall(function()

        latestRoom =
            tonumber(
                ReSt.GameData.LatestRoom.Value
            ) or 0

    end)

    --------------------------------------------------
    -- GET HOTEL ROOMS
    --------------------------------------------------

    local rooms = {}

    for _, room in next,
        workspace.CurrentRooms:GetChildren() do

        local roomNumber =
            tonumber(room.Name)

        if roomNumber
            and room:FindFirstChild("Nodes") then

            rooms[#rooms + 1] = {
                Room = room,
                Number = roomNumber,
            }

        end
    end

    --------------------------------------------------
    -- SORT ROOMS NUMERICALLY
    --------------------------------------------------

    table.sort(
        rooms,
        function(a, b)
            return a.Number < b.Number
        end
    )

    if #rooms == 0 then

        warn(
            "No room nodes found"
        )

        return
    end

    --------------------------------------------------
    -- CHOOSE 3-4 ROOMS BEHIND
    --------------------------------------------------

    local spawnBehind =
        math.random(3, 4)

    local targetRoom =
        latestRoom - spawnBehind

    local spawnRoomIndex = nil

    --------------------------------------------------
    -- FIND EXACT TARGET ROOM
    --------------------------------------------------

    for i, data in next, rooms do

        if data.Number == targetRoom then

            spawnRoomIndex = i

            break
        end
    end

    --------------------------------------------------
    -- FALLBACK
    --
    -- If there aren't enough rooms behind,
    -- use the oldest available room.
    --------------------------------------------------

    if not spawnRoomIndex then

        for i, data in next, rooms do

            if data.Number < latestRoom then

                spawnRoomIndex = i

                break
            end

        end
    end

    --------------------------------------------------
    -- ABSOLUTE FALLBACK
    --------------------------------------------------

    if not spawnRoomIndex then

        spawnRoomIndex = 1

    end

    --------------------------------------------------
    -- BUILD NODES FROM SPAWN ROOM FORWARD
    --------------------------------------------------

    local nodes = {}

    for i = spawnRoomIndex,
        #rooms do

        local room =
            rooms[i].Room

        local roomNodes =
            room.Nodes:GetChildren()

        --------------------------------------------------
        -- SORT NODES
        --------------------------------------------------

        table.sort(
            roomNodes,
            function(a, b)

                local aNumber =
                    tonumber(a.Name)

                local bNumber =
                    tonumber(b.Name)

                if aNumber and bNumber then

                    return aNumber < bNumber

                end

                return a.Name < b.Name
            end
        )

        for _, node in next,
            roomNodes do

            nodes[#nodes + 1] =
                node

        end
    end

    if #nodes == 0 then

        warn(
            "No nodes found in spawn rooms"
        )

        return
    end

    --------------------------------------------------
    -- PARENT ENTITY
    --------------------------------------------------

    entity.Model.Parent =
        workspace

    --------------------------------------------------
    -- FLICKER
    --------------------------------------------------

    if entity.Config.FlickerLights[1] then

        local latestRoomObject =
            workspace.CurrentRooms[
                tostring(latestRoom)
            ]

        if latestRoomObject then

            task.spawn(
                ModuleScripts.ModuleEvents.flickerLights,
                latestRoomObject,
                entity.Config.FlickerLights[2]
            )

        end
    end

    entity.Debug.OnEntitySpawned(
        entity
    )

    task.wait(
        entity.Config.DelayTime or 0
    )

    --------------------------------------------------
    -- MOVEMENT CONNECTION
    --------------------------------------------------

    local enteredRooms = {}

    Connections[entity.Model].Movement =
        RS.Stepped:Connect(
            function()

                if not entity.Model.Parent
                    or not entity.Model.PrimaryPart then

                    return
                end

                if Hum.Health <= 0 then
                    return
                end

                local entityPos =
                    entity.Model.PrimaryPart.Position

                local rootPos =
                    Root.Position

                local found =
                    FindPartOnRayWithIgnoreList(
                        workspace,
                        Ray.new(
                            entityPos,
                            rootPos - entityPos
                        ),
                        {
                            entity.Model,
                            Char
                        }
                    )

                --------------------------------------------------
                -- GROUND
                --------------------------------------------------

                local groundRay =
                    Ray.new(
                        entityPos,
                        Vector3.new(
                            0,
                            -4.5
                                - entity.Config.HeightOffset
                        )
                    )

                local groundFound =
                    FindPartOnRayWithIgnoreList(
                        workspace,
                        groundRay,
                        {
                            entity.Model,
                            Char
                        }
                    )

                if groundFound
                    and (
                        groundFound.Name == "Floor"
                        or string.find(
                            groundFound.Name,
                            "Carpet"
                        )
                    ) then

                    for _, room in next,
                        workspace.CurrentRooms:GetChildren() do

                        if groundFound:IsDescendantOf(room)
                            and not table.find(
                                enteredRooms,
                                room
                            ) then

                            enteredRooms[
                                #enteredRooms + 1
                            ] = room

                            entity.Debug.OnEntityEnteredRoom(
                                entity,
                                room
                            )

                        end
                    end
                end

                --------------------------------------------------
                -- NO WALL
                --------------------------------------------------

                if not found then

                    local _, onScreen =
                        WorldToViewportPoint(
                            Camera,
                            entityPos
                        )

                    if onScreen then

                        entity.Debug.OnLookAtEntity(
                            entity
                        )

                    end

                    --------------------------------------------------
                    -- KILL RANGE
                    --------------------------------------------------

                    if (
                        Root.Position
                        - entity.Model.PrimaryPart.Position
                    ).Magnitude
                        <= entity.Config.KillRange then

                        local doggo =
                            workspace:FindFirstChild(
                                "Doggo"
                            )

                        local crucifix =
                            Char:FindFirstChild(
                                "Crucifix"
                            )

                        --------------------------------------------------
                        -- CRUCIFIX
                        --------------------------------------------------

                        if doggo or crucifix then

                            Connections[
                                entity.Model
                            ].Movement:Disconnect()

                            if Connections[
                                entity.Model
                            ].Drag then

                                Connections[
                                    entity.Model
                                ].Drag:Disconnect()

                            end

                            entity.Model:SetAttribute(
                                "StopMovement",
                                true
                            )

                            local rushPart =
                                entity.Model:FindFirstChild(
                                    "RushNew",
                                    true
                                )

                            if rushPart then

                                local effect

                                pcall(function()

                                    effect =
                                        game:GetObjects(
                                            "rbxassetid://11584227521"
                                        )[1]

                                end)

                                if effect then

                                    effect.Parent =
                                        workspace

                                    pcall(function()

                                        effect:PivotTo(
                                            rushPart.CFrame
                                            - Vector3.new(
                                                0,
                                                3,
                                                0
                                            )
                                        )

                                        for i = 1, 4 do

                                            local chain =
                                                effect:FindFirstChild(
                                                    "Chain"
                                                        .. i
                                                )

                                            local beam =
                                                chain
                                                and chain.Attachment
                                                and chain.Attachment:
                                                    FindFirstChildOfClass(
                                                        "Beam"
                                                    )

                                            local attachment =
                                                rushPart:FindFirstChild(
                                                    "Attachment"
                                                )

                                            if beam
                                                and attachment then

                                                beam.Attachment1 =
                                                    attachment

                                            end
                                        end

                                    end)
                                end

                                task.wait(0.5)

                                if entity.Model.Parent
                                    and rushPart.Parent then

                                    TS:Create(
                                        rushPart,
                                        TweenInfo.new(
                                            2,
                                            Enum.EasingStyle.Sine,
                                            Enum.EasingDirection.In
                                        ),
                                        {
                                            CFrame =
                                                rushPart.CFrame
                                                + Vector3.new(
                                                    0,
                                                    20,
                                                    0
                                                )
                                        }
                                    ):Play()

                                    task.wait(2)

                                end

                                if effect then
                                    effect:Destroy()
                                end
                            end

                            local hadDoggo =
                                doggo ~= nil

                            if entity.Model.Parent then
                                entity.Model:Destroy()
                            end

                            Connections[
                                entity.Model
                            ] = nil

                            if hadDoggo then

                                local growl =
                                    doggo:FindFirstChild(
                                        "Growl"
                                    )

                                if growl then
                                    growl:Play()
                                end

                            end

                            return
                        end

                        --------------------------------------------------
                        -- NORMAL KILL
                        --------------------------------------------------

                        if entity.Config.CanKill
                            and not Char:GetAttribute(
                                "Hiding"
                            )
                            and not shouldDeflect() then

                            Connections[
                                entity.Model
                            ].Movement:Disconnect()

                            --------------------------------------------------
                            -- JUMPSCARE
                            --------------------------------------------------

                            if entity.Config.Jumpscare
                                and entity.Config.Jumpscare[1] then

                                Creator.runJumpscare(
                                    entity.Config.Jumpscare[2]
                                )

                            end

                            --------------------------------------------------
                            -- DEATH
                            --------------------------------------------------

                            Hum.Health = 0

                            entity.Debug.OnDeath(
                                entity
                            )

                            if #entity.Config.CustomDialog > 0 then

                                ReSt.GameStats[
                                    "Player_" .. Plr.Name
                                ].Total.DeathCause.Value =
                                    entity.Model.Name

                                debug.setupvalue(
                                    getconnections(
                                        ReSt.Bricks.DeathHint.OnClientEvent
                                    )[1].Function,
                                    1,
                                    entity.Config.CustomDialog
                                )

                            end
                        end
                    end
                end

                --------------------------------------------------
                -- CAMERA SHAKE
                --------------------------------------------------

                if Root
                    and entity.Model.PrimaryPart then

                    local camShake =
                        entity.Config.CamShake

                    local mag =
                        (
                            Root.Position
                            - entity.Model.PrimaryPart.Position
                        ).Magnitude

                    if camShake[1]
                        and mag <= camShake[3] then

                        local shakeRep = {}

                        for i, v in next,
                            camShake[2] do

                            shakeRep[i] = v

                        end

                        shakeRep[1] =
                            camShake[2][1]
                            / camShake[3]
                            * (
                                camShake[3]
                                - mag
                            )

                        ModuleScripts.MainGame.camShaker:
                            ShakeOnce(
                                ModuleScripts.MainGame.camShaker,
                                table.unpack(
                                    shakeRep
                                )
                            )

                        shakeRep = nil
                    end
                end
            end
        )

    entity.Debug.OnEntityStartMoving(
        entity
    )

    --------------------------------------------------
    -- BACKWARDS MOVEMENT
    --------------------------------------------------

    if entity.Config.BackwardsMovement then

        local inverseNodes = {}

        for i = #nodes, 1, -1 do

            inverseNodes[
                #inverseNodes + 1
            ] = nodes[i]

        end

        nodes = inverseNodes
    end

    local cycles =
        entity.Config.Cycles

    local nodeHeightOffset =
        3.5
        + entity.Config.HeightOffset

    --------------------------------------------------
    -- SPAWN ENTITY
    --------------------------------------------------

    entity.Model:SetPrimaryPartCFrame(
        nodes[1].CFrame
        + Vector3.new(
            0,
            nodeHeightOffset,
            0
        )
    )

    --------------------------------------------------
    -- CYCLES
    --------------------------------------------------

    for cycle = 1,
        math.random(
            cycles.Min,
            cycles.Max
        ) do

        --------------------------------------------------
        -- FORWARD
        --------------------------------------------------

        for i = 1, #nodes do

            if not entity.Model:GetAttribute(
                "StopMovement"
            ) then

                if entity.Config.BreakLights then

                    ModuleScripts.ModuleEvents.breakLights(
                        nodes[i].Parent.Parent
                    )

                end

                drag(
                    entity.Model,
                    nodes[i].Position
                    + Vector3.new(
                        0,
                        nodeHeightOffset,
                        0
                    ),
                    entity.Config.Speed
                )
            end
        end

        --------------------------------------------------
        -- REBOUND
        --------------------------------------------------

        if cycles.Max > 1 then

            for i = #nodes, 1, -1 do

                if not entity.Model:GetAttribute(
                    "StopMovement"
                ) then

                    drag(
                        entity.Model,
                        nodes[i].Position
                        + Vector3.new(
                            0,
                            nodeHeightOffset,
                            0
                        ),
                        entity.Config.Speed
                    )

                end
            end
        end

        entity.Debug.OnEntityFinishedRebound(
            entity
        )

        task.wait(
            cycles.WaitTime or 0
        )
    end

    --------------------------------------------------
    -- DESPAWN
    --------------------------------------------------

    if entity.Model.Parent then
        destroy(entity)
    end
end

