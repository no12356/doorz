--------------------------------------------------
-- MISC
--------------------------------------------------

local function drag(model, dest, speed)

    if not Connections[model] then
        return
    end

    if Connections[model].Drag then
        Connections[model].Drag:Disconnect()
    end

    local reached = false

    Connections[model].Drag = RS.Stepped:Connect(function(_, step)

        if model.Parent and model.PrimaryPart then

            local rootPos = model.PrimaryPart.Position

            local diff =
                Vector3.new(dest.X, dest.Y, dest.Z)
                - rootPos

            if diff.Magnitude > 0.1 then

                model:SetPrimaryPartCFrame(
                    CFrame.new(
                        rootPos
                        + diff.Unit
                        * math.min(
                            step * speed,
                            diff.Magnitude
                        )
                    )
                )

            else

                Connections[model].Drag:Disconnect()
                reached = true

            end

        elseif Connections[model].Drag then

            Connections[model].Drag:Disconnect()

        end
    end)

    repeat
        task.wait()
    until reached or not model.Parent
end

--------------------------------------------------
-- SOUND
--------------------------------------------------

local function playSound(soundId, properties)

    for i, v in next, StoredSounds do

        if v then
            pcall(function()
                v:Stop()
                v:Destroy()
            end)
        end

        StoredSounds[i] = nil
    end

    local sound = Instance.new("Sound")

    sound.Name = "CustomEntitySound"

    if typeof(soundId) == "number" then

        sound.SoundId =
            "rbxassetid://"
            .. tostring(soundId)

    elseif typeof(soundId) == "string" then

        if string.find(
            soundId,
            "rbxassetid://"
        ) then

            sound.SoundId = soundId

        else

            local digits =
                string.match(
                    soundId,
                    "%d+"
                )

            if digits then
                sound.SoundId =
                    "rbxassetid://"
                    .. digits
            end

        end
    end

    if typeof(properties) == "table" then

        for i, v in next, properties do

            if i ~= "SoundId"
                and i ~= "Playing"
                and i ~= "Parent" then

                pcall(function()
                    sound[i] = v
                end)

            end
        end
    end

    sound.Parent = workspace

    if not sound.IsLoaded then

        pcall(function()
            sound.Loaded:Wait()
        end)

    end

    sound:Play()

    StoredSounds[#StoredSounds + 1] =
        sound

    return sound
end

--------------------------------------------------
-- DESTROY
--------------------------------------------------

local function destroy(entityTable)

    if not entityTable then
        return
    end

    local model = entityTable.Model

    if Connections[model] then

        for _, v in next,
            Connections[model] do

            if v then

                pcall(function()
                    v:Disconnect()
                end)

            end
        end

        Connections[model] = nil
    end

    if model and model.Parent then
        model:Destroy()
    end

    if entityTable.Debug
        and entityTable.Debug.OnEntityDespawned then

        entityTable.Debug.OnEntityDespawned(
            entityTable
        )

    end
end

