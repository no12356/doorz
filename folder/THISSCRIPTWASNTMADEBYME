----------------------------------------------------------------

Creator.runJumpscare = function(config)

    if not config then
        return
    end

    ------------------------------------------------------------
    -- LOAD ASSETS
    ------------------------------------------------------------

    local image1 = LoadCustomAsset(config.Image1)
    local image2 = LoadCustomAsset(config.Image2)

    local sound1
    local sound2

    ------------------------------------------------------------
    -- MOVE PLAYER
    ------------------------------------------------------------

    if Char
        and Char.Parent
        and Char.PrimaryPart then

        pcall(function()
            Char:SetPrimaryPartCFrame(
                CFrame.new(0, 9e9, 0)
            )
        end)
    end

    ------------------------------------------------------------
    -- UI
    ------------------------------------------------------------

    local JumpscareGui =
        Instance.new("ScreenGui")

    local Background =
        Instance.new("Frame")

    local Face =
        Instance.new("ImageLabel")

    JumpscareGui.Name = "JumpscareGui"
    JumpscareGui.IgnoreGuiInset = true
    JumpscareGui.ZIndexBehavior =
        Enum.ZIndexBehavior.Sibling

    Background.Name = "Background"
    Background.BackgroundColor3 =
        Color3.fromRGB(0, 0, 0)

    Background.BorderSizePixel = 0
    Background.Size =
        UDim2.new(1, 0, 1, 0)

    Background.ZIndex = 999

    Face.Name = "Face"
    Face.AnchorPoint =
        Vector2.new(0.5, 0.5)

    Face.BackgroundTransparency = 1

    Face.Position =
        UDim2.new(0.5, 0, 0.5, 0)

    Face.ResampleMode =
        Enum.ResamplerMode.Pixelated

    Face.Size =
        UDim2.new(0, 150, 0, 150)

    Face.Image = image1

    Face.Parent = Background
    Background.Parent = JumpscareGui
    JumpscareGui.Parent = CG

    ------------------------------------------------------------
    -- TEASE
    ------------------------------------------------------------

    local tease =
        config.Tease or {false, 1, 5}

    if tease[1] then

        if typeof(config.Sound1) == "table" then

            sound1 = playSound(
                config.Sound1[1],
                config.Sound1[2]
            )
        end

        local teaseMin =
            tonumber(tease.Min) or 1

        local teaseMax =
            tonumber(tease.Max) or teaseMin

        local rdmTease =
            math.random(
                teaseMin,
                math.max(teaseMin, teaseMax)
            )

        for _ = teaseMin, rdmTease do

            task.wait(
                math.random(100, 200) / 100
            )

            local growFactor =
                (MaxTeaseSize - MinTeaseSize)
                / math.max(rdmTease, 1)

            Face.Size =
                UDim2.new(
                    0,
                    Face.AbsoluteSize.X + growFactor,
                    0,
                    Face.AbsoluteSize.Y + growFactor
                )
        end

        task.wait(
            math.random(100, 200) / 100
        )
    end

    ------------------------------------------------------------
    -- FLASH
    ------------------------------------------------------------

    local flashing =
        config.Flashing or {
            false,
            Color3.new(1, 1, 1)
        }

    if flashing[1] then

        task.spawn(function()

            while JumpscareGui
                and JumpscareGui.Parent do

                Background.BackgroundColor3 =
                    flashing[2]

                task.wait(
                    math.random(25, 100) / 1000
                )

                if not JumpscareGui.Parent then
                    break
                end

                Background.BackgroundColor3 =
                    Color3.new(0, 0, 0)

                task.wait(
                    math.random(25, 100) / 1000
                )
            end
        end)
    end

    ------------------------------------------------------------
    -- SHAKE
    ------------------------------------------------------------

    if config.Shake then

        task.spawn(function()

            local origin =
                Face.Position

            while JumpscareGui
                and JumpscareGui.Parent do

                Face.Position =
                    origin
                    + UDim2.new(
                        0,
                        math.random(-10, 10),
                        0,
                        math.random(-10, 10)
                    )

                Face.Rotation =
                    math.random(-5, 5)

                task.wait()
            end
        end)
    end

    ------------------------------------------------------------
    -- SECOND SOUND
    ------------------------------------------------------------

    if typeof(config.Sound2) == "table" then

        sound2 = playSound(
            config.Sound2[1],
            config.Sound2[2]
        )
    end

    ------------------------------------------------------------
    -- MAIN IMAGE
    ------------------------------------------------------------

    Face.Image = image2

    Face.Size =
        UDim2.new(
            0,
            750,
            0,
            750
        )

    TS:Create(
        Face,
        TweenInfo.new(0.75),
        {
            Size =
                UDim2.new(
                    0,
                    2000,
                    0,
                    2000
                ),

            ImageTransparency = 0.5,
        }
    ):Play()

    task.wait(0.75)

    ------------------------------------------------------------
    -- CLEANUP GUI
    ------------------------------------------------------------

    if JumpscareGui.Parent then
        JumpscareGui:Destroy()
    end

    if sound1 then
        pcall(function()
            sound1:Stop()
            sound1:Destroy()
        end)
    end

    if sound2 then
        pcall(function()
            sound2:Stop()
            sound2:Destroy()
        end)
    end
end

