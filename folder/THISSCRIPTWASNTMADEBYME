----------------------------------------------------------------
-- SAFE CONNECTION DISCONNECT
----------------------------------------------------------------

local function disconnect(connection)
    if connection then
        pcall(function()
            connection:Disconnect()
        end)
    end
end

----------------------------------------------------------------
-- DRAG
----------------------------------------------------------------

local function drag(model, dest, speed)

    if not model or not model.Parent then
        return false
    end

    if not Connections[model] then
        Connections[model] = {}
    end

    disconnect(Connections[model].Drag)
    Connections[model].Drag = nil

    local reached = false

    Connections[model].Drag = RS.Stepped:Connect(function(_, step)

        if not model or not model.Parent then
            disconnect(Connections[model] and Connections[model].Drag)

            if Connections[model] then
                Connections[model].Drag = nil
            end

            reached = true
            return
        end

        if not model.PrimaryPart then
            reached = true
            return
        end

        local rootPos = model.PrimaryPart.Position
        local diff = dest - rootPos

        if diff.Magnitude > 0.1 then

            model:SetPrimaryPartCFrame(
                CFrame.new(
                    rootPos +
                    diff.Unit *
                    math.min(step * speed, diff.Magnitude)
                )
            )

        else

            disconnect(Connections[model].Drag)
            Connections[model].Drag = nil

            reached = true
        end
    end)

    repeat
        task.wait()
    until reached or not model or not model.Parent

    return reached
end

----------------------------------------------------------------
-- SOUND
----------------------------------------------------------------

local function playSound(soundId, properties)

    for i, sound in next, StoredSounds do
        if sound then
            pcall(function()
                sound:Destroy()
            end)
        end

        StoredSounds[i] = nil
    end

    local sound = Instance.new("Sound")

    sound.SoundId = "rbxassetid://" ..
        ({string.gsub(tostring(soundId), "%D", "")})[1]

    sound.Playing = true
    sound.Parent = workspace

    if properties then
        for property, value in next, properties do
            if property ~= "SoundId"
                and property ~= "Playing"
                and property ~= "Parent" then

                pcall(function()
                    sound[property] = value
                end)
            end
        end
    end

    table.insert(StoredSounds, sound)

    return sound
end

----------------------------------------------------------------
-- DESTROY ENTITY
----------------------------------------------------------------

local function destroy(entityTable)

    if not entityTable then
        return
    end

    local model = entityTable.Model

    if not model then
        return
    end

    local connections = Connections[model]

    if connections then

        for _, connection in next, connections do
            disconnect(connection)
        end

        Connections[model] = nil
    end

    if model.Parent then
        pcall(function()
            model:Destroy()
        end)
    end

    if entityTable.Debug
        and entityTable.Debug.OnEntityDespawned then

        pcall(function()
            entityTable.Debug.OnEntityDespawned(entityTable)
        end)
    end
end

----------------------------------------------------------------
-- DEFLECTION
----------------------------------------------------------------

local function shouldDeflect()

    if workspace:FindFirstChild("Doggo") then
        return true
    end

    if Char and Char:FindFirstChild("Crucifix") then
        return true
    end

    return false
end

----------------------------------------------------------------
-- CREATE ENTITY
----------------------------------------------------------------

Creator.createEntity = function(config)

    assert(typeof(config) == "table")
    assert(config.Model, "Entity.Model is required")

    ------------------------------------------------------------
    -- CONFIG
    ------------------------------------------------------------

    for i, v in next, DefaultConfig do
        if config[i] == nil then

            if typeof(v) == "table" then
                config[i] = table.clone(v)
            else
                config[i] = v
            end
        end
    end

    config.Speed = StaticRushSpeed / 100 * config.Speed

    ------------------------------------------------------------
    -- LOAD MODEL
    ------------------------------------------------------------

    local entityModel = LoadCustomInstance(config.Model)

    if typeof(entityModel) ~= "Instance"
        or not entityModel:IsA("Model") then

        warn("Failure - Could not obtain model")

        return nil
    end

    ------------------------------------------------------------
    -- PRIMARY PART
    ------------------------------------------------------------

    local pPart =
        entityModel.PrimaryPart
        or entityModel:FindFirstChildWhichIsA("BasePart", true)

    if not pPart then
        warn("Failure - Could not find model's PrimaryPart")
        return nil
    end

    entityModel.PrimaryPart = pPart

    pPart.Anchored = true

    entityModel:SetAttribute("IsCustomEntity", true)
    entityModel:SetAttribute("StopMovement", false)

    if config.CustomName then
        entityModel.Name = config.CustomName
    end

    ------------------------------------------------------------
    -- COLLISION
    ------------------------------------------------------------

    for _, v in next, entityModel:GetDescendants() do

        if v:IsA("BasePart") then
            v.CanCollide = false
        end
    end

    ------------------------------------------------------------
    -- CONNECTION TABLE
    ------------------------------------------------------------

    Connections[entityModel] = {}

    ------------------------------------------------------------
    -- RETURN ENTITY
    ------------------------------------------------------------

    return {

        Model = entityModel,

        Config = config,

        Debug = {

            OnEntitySpawned = function() end,

            OnEntityDespawned = function() end,

            OnEntityStartMoving = function() end,

            OnEntityFinishedRebound = function() end,

            OnEntityEnteredRoom = function() end,

            OnLookAtEntity = function() end,

            OnDeath = function() end,
        },
    }
end

----------------------------------------------------------------
-- RUN ENTITY
----------------------------------------------------------------

Creator.runEntity = function(entity)

    if not entity
        or not entity.Model
        or not entity.Config then

        warn("Cannot run invalid entity")
        return
    end

    local model = entity.Model

    if not Connections[model] then
        Connections[model] = {}
    end

    ------------------------------------------------------------
    -- OBTAIN NODES
    ------------------------------------------------------------

    local nodes = {}

    for _, room in next, workspace.CurrentRooms:GetChildren() do

        local nodeFolder = room:FindFirstChild("Nodes")

        if nodeFolder then

            local roomNodes = nodeFolder:GetChildren()

            table.sort(roomNodes, function(a, b)
                return a.Name < b.Name
            end)

            for _, node in next, roomNodes do
                table.insert(nodes, node)
            end
        end
    end

    if #nodes == 0 then
        warn("No nodes found")
        destroy(entity)
        return
    end

    ------------------------------------------------------------
    -- PRE-CYCLE SETUP
    ------------------------------------------------------------

    local currentRooms = workspace:FindFirstChild("CurrentRooms")

    if not currentRooms then
        destroy(entity)
        return
    end

    local firstRoom = currentRooms:GetChildren()[1]

    model.Parent = workspace

    if entity.Config.FlickerLights[1] then

        pcall(function()

            local latestRoom =
                currentRooms[ReSt.GameData.LatestRoom.Value]

            if latestRoom then
                task.spawn(
                    ModuleScripts.ModuleEvents.flickerLights,
                    latestRoom,
                    entity.Config.FlickerLights[2]
                )
            end

        end)
    end

    pcall(function()
        entity.Debug.OnEntitySpawned(entity)
    end)

    task.wait(entity.Config.DelayTime or 0)

    if not model.Parent then
        return
    end

    ------------------------------------------------------------
    -- ENTERED ROOMS
    ------------------------------------------------------------

    local enteredRooms = {}

    ------------------------------------------------------------
    -- MOVEMENT CONNECTION
    ------------------------------------------------------------

    Connections[model].Movement = RS.Stepped:Connect(function()

        if not model.Parent then
            disconnect(Connections[model] and Connections[model].Movement)

            if Connections[model] then
                Connections[model].Movement = nil
            end

            return
        end

        if Hum.Health <= 0 then
            disconnect(Connections[model] and Connections[model].Movement)

            if Connections[model] then
                Connections[model].Movement = nil
            end

            return
        end

        if not model.PrimaryPart then
            return
        end

        --------------------------------------------------------
        -- POSITIONS
        --------------------------------------------------------

        local entityPos = model.PrimaryPart.Position
        local rootPos = Root.Position

        --------------------------------------------------------
        -- LINE OF SIGHT
        --------------------------------------------------------

        local found = FindPartOnRayWithIgnoreList(
            workspace,
            Ray.new(entityPos, rootPos - entityPos),
            {model, Char}
        )

        --------------------------------------------------------
        -- GROUND
        --------------------------------------------------------

        local groundRay = Ray.new(
            entityPos,
            Vector3.new(
                0,
                -4.5 - entity.Config.HeightOffset,
                0
            )
        )

        local groundFound =
            FindPartOnRayWithIgnoreList(
                workspace,
                groundRay,
                {model, Char}
            )

        --------------------------------------------------------
        -- ROOM DETECTION
        --------------------------------------------------------

        if groundFound
            and (
                groundFound.Name == "Floor"
                or string.find(groundFound.Name, "Carpet")
            ) then

            for _, room in next, currentRooms:GetChildren() do

                if groundFound:IsDescendantOf(room)
                    and not table.find(enteredRooms, room) then

                    table.insert(enteredRooms, room)

                    pcall(function()
                        entity.Debug.OnEntityEnteredRoom(
                            entity,
                            room
                        )
                    end)
                end
            end
        end

        --------------------------------------------------------
        -- NO OBSTRUCTION
        --------------------------------------------------------

        if not found then

            ----------------------------------------------------
            -- LOOK AT
            ----------------------------------------------------

            local _, onScreen =
                WorldToViewportPoint(
                    Camera,
                    entityPos
                )

            if onScreen then

                pcall(function()
                    entity.Debug.OnLookAtEntity(entity)
                end)
            end

            ----------------------------------------------------
            -- KILL RANGE
            ----------------------------------------------------

            local distance =
                (Root.Position - entityPos).Magnitude

            if distance <= entity.Config.KillRange then

                local doggo =
                    workspace:FindFirstChild("Doggo")

                local crucifix =
                    Char:FindFirstChild("Crucifix")

                ------------------------------------------------
                -- CRUCIFIX / DOGGO
                ------------------------------------------------

                if doggo or crucifix then

                    -- IMPORTANT:
                    -- Stop all entity movement first

                    local entityConnections =
                        Connections[model]

                    if entityConnections then

                        disconnect(entityConnections.Movement)
                        disconnect(entityConnections.Drag)

                        entityConnections.Movement = nil
                        entityConnections.Drag = nil
                    end

                    model:SetAttribute(
                        "StopMovement",
                        true
                    )

                    ------------------------------------------------
                    -- CRUCIFIX EFFECT
                    ------------------------------------------------

                    local effect

                    pcall(function()

                        local objects =
                            game:GetObjects(
                                "rbxassetid://11584227521"
                            )

                        effect = objects and objects[1]

                    end)

                    if effect then

                        effect.Parent = workspace

                        local rushNew =
                            model:FindFirstChild("RushNew")

                        if rushNew
                            and rushNew:IsA("BasePart") then

                            pcall(function()
                                effect:PivotTo(
                                    rushNew.CFrame
                                    - Vector3.new(0, 3, 0)
                                )
                            end)

                            local attachment =
                                rushNew:FindFirstChild(
                                    "Attachment"
                                )

                            if attachment then

                                for i = 1, 4 do

                                    local chain =
                                        effect:FindFirstChild(
                                            "Chain" .. i
                                        )

                                    if chain then

                                        local chainAttachment =
                                            chain:FindFirstChild(
                                                "Attachment"
                                            )

                                        if chainAttachment then

                                            local beam =
                                                chainAttachment:
                                                FindFirstChildOfClass(
                                                    "Beam"
                                                )

                                            if beam then
                                                beam.Attachment1 =
                                                    attachment
                                            end
                                        end
                                    end
                                end
                            end

                            task.wait(0.5)

                            if model.Parent
                                and rushNew.Parent then

                                pcall(function()

                                    TS:Create(
                                        rushNew,
                                        TweenInfo.new(
                                            2,
                                            Enum.EasingStyle.Sine,
                                            Enum.EasingDirection.In
                                        ),
                                        {
                                            CFrame =
                                                rushNew.CFrame
                                                + Vector3.new(0, 20, 0)
                                        }
                                    ):Play()

                                end)

                                task.wait(2)
                            end
                        end

                        if effect.Parent then
                            effect:Destroy()
                        end
                    end

                    ------------------------------------------------
                    -- DOGGO
                    ------------------------------------------------

                    if doggo
                        and doggo:FindFirstChild("Growl") then

                        pcall(function()
                            doggo.Growl:Play()
                        end)

                        local entityPos2

                        if model.Parent
                            and model.PrimaryPart then

                            entityPos2 =
                                model.PrimaryPart.Position
                        end

                        if entityPos2 then

                            local nodeIdx = nil
                            local nearest = math.huge

                            for i, node in next, nodes do

                                local dist =
                                    (
                                        node.Position
                                        - entityPos2
                                    ).Magnitude

                                if dist < nearest then

                                    nodeIdx = i
                                    nearest = dist
                                end
                            end

                            if nodeIdx then

                                for i = nodeIdx, 1, -1 do

                                    if not model.Parent then
                                        break
                                    end

                                    drag(
                                        model,
                                        nodes[i].Position
                                        + Vector3.new(
                                            0,
                                            3.5
                                                + entity.Config.HeightOffset,
                                            0
                                        ),
                                        entity.Config.Speed
                                    )
                                end
                            end
                        end
                    end

                    ------------------------------------------------
                    -- CLEANUP
                    ------------------------------------------------

                    destroy(entity)

                    return
                end

                ------------------------------------------------
                -- KILL PLAYER
                ------------------------------------------------

                local hiding = false

                pcall(function()
                    hiding =
                        Char:GetAttribute("Hiding") == true
                end)

                if entity.Config.CanKill
                    and not hiding
                    and not shouldDeflect() then

                    local entityConnections =
                        Connections[model]

                    if entityConnections then
                        disconnect(
                            entityConnections.Movement
                        )

                        entityConnections.Movement = nil
                    end

                    ------------------------------------------------
                    -- JUMPSCARE
                    ------------------------------------------------

                    if entity.Config.Jumpscare[1] then

                        pcall(function()
                            Creator.runJumpscare(
                                entity.Config.Jumpscare[2]
                            )
                        end)
                    end

                    ------------------------------------------------
                    -- DEATH
                    ------------------------------------------------

                    Hum.Health = 0

                    pcall(function()
                        entity.Debug.OnDeath(entity)
                    end)

                    ------------------------------------------------
                    -- DEATH DIALOG
                    ------------------------------------------------

                    if #entity.Config.CustomDialog > 0 then

                        pcall(function()

                            local stats =
                                ReSt.GameStats[
                                    "Player_" .. Plr.Name
                                ]

                            if stats
                                and stats.Total
                                and stats.Total.DeathCause then

                                stats.Total.DeathCause.Value =
                                    model.Name
                            end

                            local deathHint =
                                ReSt.Bricks.DeathHint

                            local connections =
                                getconnections(
                                    deathHint.OnClientEvent
                                )

                            if connections
                                and connections[1] then

                                debug.setupvalue(
                                    connections[1].Function,
                                    1,
                                    entity.Config.CustomDialog
                                )
                            end
                        end)
                    end
                end
            end
        end

        --------------------------------------------------------
        -- CAMERA SHAKE
        --------------------------------------------------------

        if model.Parent
            and model.PrimaryPart
            and Root then

            local camShake =
                entity.Config.CamShake

            local mag =
                (
                    Root.Position
                    - model.PrimaryPart.Position
                ).Magnitude

            if camShake[1]
                and mag <= camShake[3] then

                local shakeRep = {}

                for i, v in next, camShake[2] do
                    shakeRep[i] = v
                end

                shakeRep[1] =
                    camShake[2][1]
                    / camShake[3]
                    * (camShake[3] - mag)

                pcall(function()

                    ModuleScripts.MainGame.camShaker:
                        ShakeOnce(
                            table.unpack(shakeRep)
                        )

                end)
            end
        end
    end)

    ------------------------------------------------------------
    -- START MOVING
    ------------------------------------------------------------

    pcall(function()
        entity.Debug.OnEntityStartMoving(entity)
    end)

    ------------------------------------------------------------
    -- BACKWARDS MOVEMENT
    ------------------------------------------------------------

    if entity.Config.BackwardsMovement then

        local inverseNodes = {}

        for i = #nodes, 1, -1 do
            table.insert(inverseNodes, nodes[i])
        end

        nodes = inverseNodes
    end

    ------------------------------------------------------------
    -- NODE HEIGHT
    ------------------------------------------------------------

    local cycles =
        entity.Config.Cycles

    local nodeHeightOffset =
        3.5 + entity.Config.HeightOffset

    ------------------------------------------------------------
    -- INITIAL POSITION
    ------------------------------------------------------------

    if not model.Parent
        or not model.PrimaryPart then

        destroy(entity)
        return
    end

    model:SetPrimaryPartCFrame(
        nodes[1].CFrame
        + Vector3.new(
            0,
            nodeHeightOffset,
            0
        )
    )

    ------------------------------------------------------------
    -- CYCLES
    ------------------------------------------------------------

    local minCycles =
        tonumber(cycles.Min) or 1

    local maxCycles =
        tonumber(cycles.Max) or minCycles

    local cycleCount =
        math.random(
            minCycles,
            math.max(minCycles, maxCycles)
        )

    for cycle = 1, cycleCount do

        if not model.Parent then
            return
        end

        --------------------------------------------------------
        -- FORWARD
        --------------------------------------------------------

        for i = 1, #nodes do

            if not model.Parent then
                return
            end

            if model:GetAttribute("StopMovement") then
                break
            end

            if entity.Config.BreakLights then

                pcall(function()
                    ModuleScripts.ModuleEvents.breakLights(
                        nodes[i].Parent.Parent
                    )
                end)
            end

            drag(
                model,
                nodes[i].Position
                + Vector3.new(
                    0,
                    nodeHeightOffset,
                    0
                ),
                entity.Config.Speed
            )
        end

        --------------------------------------------------------
        -- BACKWARD REBOUND
        --------------------------------------------------------

        if maxCycles > 1
            and model.Parent
            and not model:GetAttribute("StopMovement") then

            for i = #nodes, 1, -1 do

                if not model.Parent then
                    return
                end

                if model:GetAttribute("StopMovement") then
                    break
                end

                drag(
                    model,
                    nodes[i].Position
                    + Vector3.new(
                        0,
                        nodeHeightOffset,
                        0
                    ),
                    entity.Config.Speed
                )
            end
        end

        pcall(function()
            entity.Debug.OnEntityFinishedRebound(entity)
        end)

        task.wait(cycles.WaitTime or 0)
    end

    ------------------------------------------------------------
    -- FINAL CLEANUP
    ------------------------------------------------------------

    if model.Parent then
        destroy(entity)
    else
        Connections[model] = nil
    end
end

