local function shouldDeflect()

    if workspace:FindFirstChild("Doggo") then
        return true
    elseif Char:FindFirstChild("Crucifix") then
        return true
    end

    return false
end

--------------------------------------------------
-- CREATE ENTITY
--------------------------------------------------

Creator.createEntity = function(config)

    assert(typeof(config) == "table")
    assert(config.Model)

    for i, v in next, DefaultConfig do

        if config[i] == nil then
            config[i] = v
        end

    end

    config.Speed =
        StaticRushSpeed
        / 100
        * config.Speed

    --------------------------------------------------
    -- LOAD MODEL
    --------------------------------------------------

    local entityModel =
        LoadCustomInstance(
            config.Model
        )

    if typeof(entityModel) == "Instance"
        and entityModel:IsA("Model") then

        local pPart =
            entityModel.PrimaryPart
            or entityModel:FindFirstChildWhichIsA(
                "BasePart"
            )

        if pPart then

            entityModel.PrimaryPart =
                pPart

            pPart.Anchored = true

            entityModel:SetAttribute(
                "IsCustomEntity",
                true
            )

            if config.CustomName then

                entityModel.Name =
                    config.CustomName

            end

            for _, v in next,
                entityModel:GetDescendants() do

                if v:IsA("BasePart") then
                    v.CanCollide = false
                end

            end

            Connections[entityModel] = {}

            return {
                Model = entityModel,
                Config = config,

                Debug = {
                    OnEntitySpawned = function() end,
                    OnEntityDespawned = function() end,
                    OnEntityStartMoving = function() end,
                    OnEntityFinishedRebound = function() end,
                    OnEntityEnteredRoom = function() end,
                    OnLookAtEntity = function() end,
                    OnDeath = function() end,
                },
            }

        else

            warn(
                "Failure - Could not find model's PrimaryPart"
            )

        end

    else

        warn(
            "Failure - Could not obtain model"
        )

    end
end

--------------------------------------------------
-- RUN ENTITY
--------------------------------------------------

Creator.runEntity = function(entity)

    if not entity or not entity.Model then
        warn("Invalid entity")
        return
    end

    --------------------------------------------------
    -- GET LATEST ROOM
    --------------------------------------------------

    local latestRoom = 0

    pcall(function()

        latestRoom =
            tonumber(
                ReSt.GameData.LatestRoom.Value
            ) or 0

    end)

    --------------------------------------------------
    -- GET LOADED ROOMS
    --------------------------------------------------

    local function getLoadedRooms()

        local loadedRooms = {}

        local currentRooms =
            workspace:FindFirstChild("CurrentRooms")

        if not currentRooms then
            return loadedRooms
        end

        for _, room in next,
            currentRooms:GetChildren() do

            local roomNumber =
                tonumber(room.Name)

            if roomNumber then

                loadedRooms[#loadedRooms + 1] = {
                    Room = room,
                    Number = roomNumber,
                }

            end
        end

        table.sort(
            loadedRooms,
            function(a, b)
                return a.Number < b.Number
            end
        )

        return loadedRooms
    end

    --------------------------------------------------
    -- GET SORTED ROOM NODES
    --------------------------------------------------

    local function getRoomNodes(room)

        if not room
            or not room.Parent then

            return {}
        end

        local nodeFolder =
            room:FindFirstChild("Nodes")

        if not nodeFolder then
            return {}
        end

        local roomNodes = {}

        for _, node in next,
            nodeFolder:GetChildren() do

            if node:IsA("BasePart") then
                roomNodes[#roomNodes + 1] = node
            end
        end

        table.sort(
            roomNodes,
            function(a, b)

                local aNumber =
                    tonumber(a.Name)

                local bNumber =
                    tonumber(b.Name)

                if aNumber and bNumber then
                    return aNumber < bNumber
                end

                if aNumber then
                    return true
                end

                if bNumber then
                    return false
                end

                return a.Name < b.Name
            end
        )

        return roomNodes
    end

    --------------------------------------------------
    -- INITIAL ROOMS
    --------------------------------------------------

    local rooms =
        getLoadedRooms()

    if #rooms == 0 then

        warn(
            "No rooms currently loaded"
        )

        return
    end

    --------------------------------------------------
    -- CHOOSE 3-4 ROOMS BEHIND PLAYER
    --------------------------------------------------

    local spawnBehind =
        math.random(3, 4)

    local targetRoom =
        latestRoom - spawnBehind

    local spawnRoomNumber

    for _, data in next, rooms do

        if data.Number == targetRoom then

            spawnRoomNumber =
                data.Number

            break
        end
    end

    --------------------------------------------------
    -- FALLBACK
    --------------------------------------------------

    if not spawnRoomNumber then

        for _, data in next, rooms do

            if data.Number < latestRoom then

                spawnRoomNumber =
                    data.Number

                break
            end
        end
    end

    --------------------------------------------------
    -- ABSOLUTE FALLBACK
    --------------------------------------------------

    if not spawnRoomNumber then

        spawnRoomNumber =
            rooms[1].Number

    end

    --------------------------------------------------
    -- DYNAMIC NODE QUEUE
    --
    -- IMPORTANT:
    --
    -- The old version only scanned a room once.
    -- If the room existed before its Nodes loaded,
    -- that room was permanently skipped.
    --
    -- This version repeatedly scans every loaded
    -- room and adds any new nodes it finds.
    --------------------------------------------------

    local nodes = {}

    local knownNodes = {}

    local consumedNodes = {}

    --------------------------------------------------
    -- UPDATE NODE QUEUE
    --------------------------------------------------

    local function updateNodeQueue()

        local currentRooms =
            getLoadedRooms()

        for _, data in next,
            currentRooms do

            if data.Number >= spawnRoomNumber then

                local roomNodes =
                    getRoomNodes(
                        data.Room
                    )

                for _, node in next,
                    roomNodes do

                    if node
                        and node.Parent
                        and node:IsDescendantOf(
                            workspace.CurrentRooms
                        )
                        and not knownNodes[node] then

                        knownNodes[node] = true

                        nodes[#nodes + 1] = {
                            Node = node,
                            RoomNumber = data.Number,
                            NodeNumber =
                                tonumber(node.Name)
                                or 999999,
                        }

                    end
                end
            end
        end

        --------------------------------------------------
        -- ALWAYS SORT BY ROOM + NODE
        --------------------------------------------------

        table.sort(
            nodes,
            function(a, b)

                if a.RoomNumber
                    ~= b.RoomNumber then

                    return a.RoomNumber
                        < b.RoomNumber

                end

                return a.NodeNumber
                    < b.NodeNumber
            end
        )
    end

    --------------------------------------------------
    -- INITIAL LOAD
    --------------------------------------------------

    updateNodeQueue()

    --------------------------------------------------
    -- WAIT FOR NODES IF THEY ARE STILL LOADING
    --------------------------------------------------

    local nodeWaitStart =
        os.clock()

    while #nodes == 0
        and os.clock() - nodeWaitStart < 10 do

        task.wait(0.1)

        updateNodeQueue()
    end

    if #nodes == 0 then

        warn(
            "No nodes found"
        )

        return
    end

    --------------------------------------------------
    -- PARENT ENTITY
    --------------------------------------------------

    entity.Model.Parent =
        workspace

    --------------------------------------------------
    -- FLICKER
    --------------------------------------------------

    if entity.Config.FlickerLights[1] then

        local latestRoomObject =
            workspace.CurrentRooms[
                tostring(latestRoom)
            ]

        if latestRoomObject then

            task.spawn(
                ModuleScripts.ModuleEvents.flickerLights,
                latestRoomObject,
                entity.Config.FlickerLights[2]
            )

        end
    end

    entity.Debug.OnEntitySpawned(
        entity
    )

    task.wait(
        entity.Config.DelayTime or 0
    )

    --------------------------------------------------
    -- UPDATE AFTER DELAY
    --------------------------------------------------

    updateNodeQueue()

    --------------------------------------------------
    -- MOVEMENT CONNECTION
    --------------------------------------------------

    local enteredRooms = {}

    Connections[entity.Model].Movement =
        RS.Stepped:Connect(
            function()

                if not entity.Model.Parent
                    or not entity.Model.PrimaryPart then

                    return
                end

                if Hum.Health <= 0 then
                    return
                end

                local entityPos =
                    entity.Model.PrimaryPart.Position

                local rootPos =
                    Root.Position

                local found =
                    FindPartOnRayWithIgnoreList(
                        workspace,
                        Ray.new(
                            entityPos,
                            rootPos - entityPos
                        ),
                        {
                            entity.Model,
                            Char
                        }
                    )

                --------------------------------------------------
                -- GROUND
                --------------------------------------------------

                local groundRay =
                    Ray.new(
                        entityPos,
                        Vector3.new(
                            0,
                            -4.5
                                - entity.Config.HeightOffset
                        )
                    )

                local groundFound =
                    FindPartOnRayWithIgnoreList(
                        workspace,
                        groundRay,
                        {
                            entity.Model,
                            Char
                        }
                    )

                if groundFound
                    and (
                        groundFound.Name == "Floor"
                        or string.find(
                            groundFound.Name,
                            "Carpet"
                        )
                    ) then

                    for _, room in next,
                        workspace.CurrentRooms:GetChildren() do

                        if groundFound:IsDescendantOf(room)
                            and not table.find(
                                enteredRooms,
                                room
                            ) then

                            enteredRooms[
                                #enteredRooms + 1
                            ] = room

                            entity.Debug.OnEntityEnteredRoom(
                                entity,
                                room
                            )

                        end
                    end
                end

                --------------------------------------------------
                -- NO WALL
                --------------------------------------------------

                if not found then

                    local _, onScreen =
                        WorldToViewportPoint(
                            Camera,
                            entityPos
                        )

                    if onScreen then

                        entity.Debug.OnLookAtEntity(
                            entity
                        )

                    end

                    --------------------------------------------------
                    -- KILL RANGE
                    --------------------------------------------------

                    if (
                        Root.Position
                        - entity.Model.PrimaryPart.Position
                    ).Magnitude
                        <= entity.Config.KillRange then

                        local doggo =
                            workspace:FindFirstChild(
                                "Doggo"
                            )

                        local crucifix =
                            Char:FindFirstChild(
                                "Crucifix"
                            )

                        --------------------------------------------------
                        -- CRUCIFIX
                        --------------------------------------------------

                        if doggo or crucifix then

                            if Connections[
                                entity.Model
                            ].Movement then

                                Connections[
                                    entity.Model
                                ].Movement:Disconnect()

                            end

                            if Connections[
                                entity.Model
                            ].Drag then

                                Connections[
                                    entity.Model
                                ].Drag:Disconnect()

                            end

                            entity.Model:SetAttribute(
                                "StopMovement",
                                true
                            )

                            local rushPart =
                                entity.Model:FindFirstChild(
                                    "RushNew",
                                    true
                                )

                            local effect

                            if rushPart then

                                pcall(function()

                                    effect =
                                        game:GetObjects(
                                            "rbxassetid://11584227521"
                                        )[1]

                                end)

                                if effect then

                                    effect.Parent =
                                        workspace

                                    pcall(function()

                                        effect:PivotTo(
                                            rushPart.CFrame
                                            - Vector3.new(
                                                0,
                                                3,
                                                0
                                            )
                                        )

                                        for i = 1, 4 do

                                            local chain =
                                                effect:FindFirstChild(
                                                    "Chain"
                                                        .. i
                                                )

                                            local beam =
                                                chain
                                                and chain.Attachment
                                                and chain.Attachment:
                                                    FindFirstChildOfClass(
                                                        "Beam"
                                                    )

                                            local attachment =
                                                rushPart:FindFirstChild(
                                                    "Attachment"
                                                )

                                            if beam
                                                and attachment then

                                                beam.Attachment1 =
                                                    attachment

                                            end
                                        end

                                    end)
                                end

                                task.wait(0.5)

                                if entity.Model.Parent
                                    and rushPart.Parent then

                                    TS:Create(
                                        rushPart,
                                        TweenInfo.new(
                                            2,
                                            Enum.EasingStyle.Sine,
                                            Enum.EasingDirection.In
                                        ),
                                        {
                                            CFrame =
                                                rushPart.CFrame
                                                + Vector3.new(
                                                    0,
                                                    20,
                                                    0
                                                )
                                        }
                                    ):Play()

                                    task.wait(2)

                                end

                                if effect then
                                    effect:Destroy()
                                end
                            end

                            local hadDoggo =
                                doggo ~= nil

                            if entity.Model.Parent then
                                entity.Model:Destroy()
                            end

                            Connections[
                                entity.Model
                            ] = nil

                            if hadDoggo then

                                local growl =
                                    doggo:FindFirstChild(
                                        "Growl"
                                    )

                                if growl then
                                    growl:Play()
                                end

                            end

                            return
                        end

                        --------------------------------------------------
                        -- NORMAL KILL
                        --------------------------------------------------

                        if entity.Config.CanKill
                            and not Char:GetAttribute(
                                "Hiding"
                            )
                            and not shouldDeflect() then

                            if Connections[
                                entity.Model
                            ].Movement then

                                Connections[
                                    entity.Model
                                ].Movement:Disconnect()

                            end

                            --------------------------------------------------
                            -- JUMPSCARE
                            --------------------------------------------------

                            if entity.Config.Jumpscare
                                and entity.Config.Jumpscare[1] then

                                Creator.runJumpscare(
                                    entity.Config.Jumpscare[2]
                                )

                            end

                            --------------------------------------------------
                            -- DEATH
                            --------------------------------------------------

                            Hum.Health = 0

                            entity.Debug.OnDeath(
                                entity
                            )

                            if #entity.Config.CustomDialog > 0 then

                                ReSt.GameStats[
                                    "Player_" .. Plr.Name
                                ].Total.DeathCause.Value =
                                    entity.Model.Name

                                debug.setupvalue(
                                    getconnections(
                                        ReSt.Bricks.DeathHint.OnClientEvent
                                    )[1].Function,
                                    1,
                                    entity.Config.CustomDialog
                                )

                            end
                        end
                    end
                end

                --------------------------------------------------
                -- CAMERA SHAKE
                --------------------------------------------------

                if Root
                    and entity.Model.PrimaryPart then

                    local camShake =
                        entity.Config.CamShake

                    local mag =
                        (
                            Root.Position
                            - entity.Model.PrimaryPart.Position
                        ).Magnitude

                    if camShake[1]
                        and mag <= camShake[3] then

                        local shakeRep = {}

                        for i, v in next,
                            camShake[2] do

                            shakeRep[i] = v

                        end

                        shakeRep[1] =
                            camShake[2][1]
                            / camShake[3]
                            * (
                                camShake[3]
                                - mag
                            )

                        ModuleScripts.MainGame.camShaker:
                            ShakeOnce(
                                ModuleScripts.MainGame.camShaker,
                                table.unpack(
                                    shakeRep
                                )
                            )

                        shakeRep = nil
                    end
                end
            end
        )

    entity.Debug.OnEntityStartMoving(
        entity
    )

    --------------------------------------------------
    -- MOVEMENT SETTINGS
    --------------------------------------------------

    local cycles =
        entity.Config.Cycles

    local nodeHeightOffset =
        3.5
        + entity.Config.HeightOffset

    --------------------------------------------------
    -- FIND FIRST NODE
    --------------------------------------------------

    updateNodeQueue()

    local firstNode

    for _, data in next, nodes do

        local node =
            data.Node

        if node
            and node.Parent
            and node:IsDescendantOf(
                workspace.CurrentRooms
            ) then

            firstNode =
                node

            break
        end
    end

    if not firstNode then

        destroy(entity)

        return
    end

    --------------------------------------------------
    -- SPAWN ENTITY
    --------------------------------------------------

    entity.Model:SetPrimaryPartCFrame(
        firstNode.CFrame
        + Vector3.new(
            0,
            nodeHeightOffset,
            0
        )
    )

    --------------------------------------------------
    -- CYCLES
    --------------------------------------------------

    local totalCycles =
        math.random(
            cycles.Min,
            cycles.Max
        )

    for cycle = 1, totalCycles do

        --------------------------------------------------
        -- FORWARD MOVEMENT
        --------------------------------------------------

        if not entity.Config.BackwardsMovement then

            while entity.Model.Parent
                and not entity.Model:GetAttribute(
                    "StopMovement"
                ) do

                --------------------------------------------------
                -- FIND NEXT UNCONSUMED NODE
                --------------------------------------------------

                updateNodeQueue()

                local nextNode
                local nextData

                for _, data in next, nodes do

                    local node =
                        data.Node

                    if not consumedNodes[node]
                        and node
                        and node.Parent
                        and node:IsDescendantOf(
                            workspace.CurrentRooms
                        ) then

                        nextNode = node
                        nextData = data

                        break
                    end
                end

                --------------------------------------------------
                -- NO NODE YET
                --
                -- WAIT FOR HOTEL TO LOAD A NEW ROOM.
                --------------------------------------------------

                if not nextNode then

                    task.wait(0.1)

                    updateNodeQueue()

                    continue
                end

                --------------------------------------------------
                -- BREAK LIGHTS
                --------------------------------------------------

                if entity.Config.BreakLights then

                    local room =
                        nextNode.Parent
                        and nextNode.Parent.Parent

                    if room
                        and room.Parent then

                        pcall(function()

                            ModuleScripts.ModuleEvents.breakLights(
                                room
                            )

                        end)
                    end
                end

                --------------------------------------------------
                -- MOVE
                --------------------------------------------------

                drag(
                    entity.Model,
                    nextNode.Position
                    + Vector3.new(
                        0,
                        nodeHeightOffset,
                        0
                    ),
                    entity.Config.Speed
                )

                --------------------------------------------------
                -- MARK NODE AS USED
                --------------------------------------------------

                consumedNodes[nextNode] = true

                --------------------------------------------------
                -- REFRESH ROOMS
                --------------------------------------------------

                updateNodeQueue()

                --------------------------------------------------
                -- SMALL WAIT
                --
                -- Gives CurrentRooms time to create the
                -- next room while Depth is moving.
                --------------------------------------------------

                task.wait()
            end

        else

            --------------------------------------------------
            -- BACKWARDS MOVEMENT
            --------------------------------------------------

            updateNodeQueue()

            local backwardsNodes = {}

            for i = #nodes, 1, -1 do

                local data =
                    nodes[i]

                local node =
                    data.Node

                if node
                    and node.Parent
                    and node:IsDescendantOf(
                        workspace.CurrentRooms
                    ) then

                    backwardsNodes[
                        #backwardsNodes + 1
                    ] = node

                end
            end

            for i = 1,
                #backwardsNodes do

                if entity.Model:GetAttribute(
                    "StopMovement"
                ) then

                    break
                end

                local node =
                    backwardsNodes[i]

                if node
                    and node.Parent then

                    if entity.Config.BreakLights then

                        local room =
                            node.Parent
                            and node.Parent.Parent

                        if room
                            and room.Parent then

                            pcall(function()

                                ModuleScripts.ModuleEvents.breakLights(
                                    room
                                )

                            end)
                        end
                    end

                    drag(
                        entity.Model,
                        node.Position
                        + Vector3.new(
                            0,
                            nodeHeightOffset,
                            0
                        ),
                        entity.Config.Speed
                    )
                end
            end
        end

        --------------------------------------------------
        -- REBOUND
        --
        -- Preserves your original Cycles behavior.
        --------------------------------------------------

        if cycles.Max > 1
            and not entity.Model:GetAttribute(
                "StopMovement"
            ) then

            updateNodeQueue()

            --------------------------------------------------
            -- REVERSE THROUGH CURRENT VALID NODES
            --------------------------------------------------

            for i = #nodes, 1, -1 do

                if entity.Model:GetAttribute(
                    "StopMovement"
                ) then

                    break
                end

                local data =
                    nodes[i]

                local node =
                    data.Node

                if node
                    and node.Parent
                    and node:IsDescendantOf(
                        workspace.CurrentRooms
                    ) then

                    drag(
                        entity.Model,
                        node.Position
                        + Vector3.new(
                            0,
                            nodeHeightOffset,
                            0
                        ),
                        entity.Config.Speed
                    )
                end
            end
        end

        --------------------------------------------------
        -- REBOUND CALLBACK
        --------------------------------------------------

        entity.Debug.OnEntityFinishedRebound(
            entity
        )

        task.wait(
            cycles.WaitTime or 0
        )

        --------------------------------------------------
        -- REFRESH BEFORE NEXT CYCLE
        --------------------------------------------------

        updateNodeQueue()
    end

    --------------------------------------------------
    -- DESPAWN
    --------------------------------------------------

    if entity.Model.Parent then
        destroy(entity)
    end
end

